{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-nexus": {
      "source": {
        "source": "git",
        "url": "https://github.com/DotNetLabX/claude-nexus.git"
      }
    }
  },
  "enabledPlugins": {
    "nexus@claude-nexus": true,
    "nexus-dotnet@claude-nexus": true
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo:*)",
      "Bash(git reset --hard:*)",
      "Bash(docker rm:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets/**)",
      "Read(./.credentials/**)"
    ]
  }
}
